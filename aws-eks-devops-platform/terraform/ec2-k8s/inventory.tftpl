# Generated by Terraform - do not edit by hand (re-run `terraform apply` to regenerate)
[control_plane]
control-plane ansible_host=${control_plane_ip} private_ip=${control_plane_private_ip}

[workers]
%{ for name, w in workers ~}
${name} ansible_host=${w.public_ip} private_ip=${w.private_ip}
%{ endfor ~}

[k8s:children]
control_plane
workers

[jenkins]
%{ for ip in jenkins_ips ~}
jenkins-server ansible_host=${ip}
%{ endfor ~}

[all:vars]
ansible_user=ubuntu
ansible_ssh_private_key_file=${private_key_path}
ansible_python_interpreter=/usr/bin/python3
